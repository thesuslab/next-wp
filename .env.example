# ==============================================================================
# The Sustainability Lab — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Engine Configuration (Lab Lens & "Ask the Lab" Advisor)
# ------------------------------------------------------------------------------
# Supported providers: "openrouter" | "openai" | "chatgpt" | "gemini" | "nvidia" | "ollama" | "simulation"
# Leave blank or "auto" to automatically select the first provider with a configured key.
LLM_PROVIDER="auto"

# Optional: Override the model for any active provider
# e.g., "anthropic/claude-3.5-sonnet", "gpt-4o", "gemini-1.5-flash", "llama3.2"
# LLM_MODEL=""

# --- Provider A: OpenRouter (Unified multi-model access) ---
# Sign up at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# --- Provider B: OpenAI (ChatGPT) ---
# Sign up at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Provider C: Google Gemini ---
# Generate key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# --- Provider D: NVIDIA NIM (NVIDIA Inference Microservices) ---
# Generate free API credits at https://build.nvidia.com
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"

# --- Provider E: Ollama (100% Free, Private, Local LLM) ---
# Install from https://ollama.com and run: `ollama run llama3.2`
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# ------------------------------------------------------------------------------
# 2. Site Identity & Domain
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Headless WordPress Integration (Optional)
# ------------------------------------------------------------------------------
# If connected to a live WordPress CMS with WPGraphQL:
WORDPRESS_URL="https://wordpress.com"
WORDPRESS_HOSTNAME="wordpress.com"

# Revalidation Webhook Secret (generate with: `openssl rand -base64 32`)
WORDPRESS_WEBHOOK_SECRET="your-secret-key-here"

# ------------------------------------------------------------------------------
# 4. Database (Optional for Railway MySQL / Seed Persistence)
# ------------------------------------------------------------------------------
# When deploying with Railway MySQL, DATABASE_URL is automatically populated:
# e.g., mysql://root:password@mysql.railway.internal:3306/railway
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 5. Automated 6:00 AM Editorial Scraping & Synthesis Pipeline
# ------------------------------------------------------------------------------
# Secret to protect /api/cron/editorial endpoint from unauthorized execution:
# Used by Railway Cron, Vercel Cron, or GitHub Actions (e.g. `0 6 * * *`)
CRON_SECRET="sustainability-lab-editorial-cron-secret"

# ------------------------------------------------------------------------------
# 6. SMTP & Contact Form Email Dispatch (Railway / Cloud Deployment)
# ------------------------------------------------------------------------------
# Required for live delivery of /collaborate intake inquiries:
# 
# For Gmail:
#   SMTP_SERVER="smtp.gmail.com"
#   SMTP_PORT="465"
#   SMTP_USERNAME="your-email@gmail.com"
#   SMTP_PASSWORD="xxxx xxxx xxxx xxxx" (16-char App Password from Google Account Security, NOT your account password)
# 
# For Resend / SendGrid / Custom SMTP:
#   SMTP_SERVER="smtp.resend.com" (or "smtp.sendgrid.net")
#   SMTP_PORT="465" (or "587")
#   SMTP_USERNAME="resend" (or "apikey")
#   SMTP_PASSWORD="re_xxxxxxxxxxxx"
#
# Optional: Where form submissions are delivered (defaults to SMTP_USERNAME or hello@sustainabilitylab.xyz)
# DIRECTORATE_EMAIL="directorate@sustainabilitylab.xyz"
#
# Optional: Custom From address (defaults to SMTP_USERNAME or DIRECTORATE_EMAIL)
# SMTP_FROM="directorate@sustainabilitylab.xyz"
SMTP_SERVER=""
SMTP_PORT="465"
SMTP_USERNAME=""
SMTP_PASSWORD=""
DIRECTORATE_EMAIL=""

